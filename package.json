{
  "name": "freemy-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-check.mjs",
    "test:analytics-browser": "node --test tests/impressions-browser.mjs tests/analytics-interactions-browser.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node src/validate.mjs",
    "learning:audit": "node scripts/check-learning-resources.mjs",
    "share:sync": "node scripts/sync-share-routes.mjs --write",
    "share:check": "node scripts/sync-share-routes.mjs --check",
    "share:export": "node scripts/export-share-index.mjs",
    "share:audit": "node scripts/check-share-links.mjs",
    "share:live": "node scripts/check-share-live.mjs",
    "seo:audit": "node scripts/check-seo.mjs --dir dist",
    "seo:live": "node scripts/check-seo-live.mjs"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.12.0",
    "parse5": "^8.1.1",
    "playwright-core": "^1.65.0"
  }
}
